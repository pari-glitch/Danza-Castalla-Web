/* CAMPUS DE NAVIDAD */
.campus-event-wrapper {
  display: flex;
  justify-content: center;
  padding: 30px 20px 50px;
}

.campus-event-card {
  position: relative;
  width: 100%;
  max-width: 650px;
  box-sizing: border-box;
  background: #ffffff;
  border: 1px solid #e9e9e9;
  border-radius: 24px;
  padding: 38px;
  text-align: center;
  box-shadow: 0 12px 35px rgba(30, 45, 65, 0.09);
  overflow: hidden;
}

.campus-event-decoration {
  font-size: 30px;
  margin-bottom: 12px;
}

.campus-event-label {
  display: inline-block;
  background: #fff2a6;
  color: #26364a;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  padding: 9px 16px;
  border-radius: 30px;
}

.campus-event-card h3 {
  color: #26364a;
  font-size: 30px;
  margin: 18px 0 5px;
}

.campus-event-brand {
  color: #d3a900;
  font-weight: 800;
  letter-spacing: 3px;
  font-size: 12px;
}

.campus-event-intro {
  color: #667085;
  line-height: 1.6;
  margin: 20px auto;
  max-width: 480px;
}

.campus-event-details {
  background: #f5f8fc;
  border-radius: 16px;
  padding: 20px;
  text-align: left;
  display: grid;
  gap: 13px;
  color: #26364a;
}

.campus-event-price {
  background: #fff8d8;
  border: 1px solid #f5e69a;
  border-radius: 18px;
  padding: 20px;
  margin: 22px 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #26364a;
}

.campus-event-price strong {
  font-size: 36px;
  color: #26364a;
}

.campus-event-price small {
  color: #667085;
}

.campus-event-card h4 {
  color: #26364a;
  font-size: 18px;
  margin: 25px 0 15px;
}

.campus-event-activities {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  text-align: left;
  color: #465467;
  font-size: 14px;
}

.campus-event-button {
  margin-top: 28px;
  width: 100%;
  max-width: 320px;
}

.campus-event-footer {
  color: #9299a5;
  font-size: 13px;
  margin: 20px 0 0;
}

@media (max-width: 600px) {
  .campus-event-card {
    padding: 25px 18px;
  }

  .campus-event-card h3 {
    font-size: 25px;
  }

  .campus-event-activities {
    grid-template-columns: 1fr;
  }
}
}
